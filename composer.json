{
    "name": "hexlet/code",
    "description": "Hexlet PHP project",
    "type": "project",
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.10",
        "nesbot/carbon": "^3.11",
        "slim/flash": "^0.4.0",
        "slim/php-view": "^3.4",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "symfony/css-selector": "^8.0",
        "symfony/dom-crawler": "^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "lint": "phpcs",
        "phpstan": "phpstan analyse -c phpstan.neon --memory-limit=256M"
    }
}
