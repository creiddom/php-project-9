{
    "name": "hexlet/code",
    "description": "Hexlet PHP project",
    "type": "project",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.10",
        "nesbot/carbon": "^3.11",
        "php-di/php-di": "^7.0",
        "slim/flash": "^0.4.0",
        "slim/http": "^1.0",
        "slim/php-view": "^3.4",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "symfony/css-selector": "^7.0",
        "symfony/dom-crawler": "^7.0",
        "vlucas/valitron": "^1.4"
    },
    "require-dev": {
        "dg/bypass-finals": "^1.9",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "lint": "phpcs",
        "phpstan": "phpstan analyse -c phpstan.neon --memory-limit=256M",
        "test": "phpunit --coverage-clover coverage.xml"
    }
}
